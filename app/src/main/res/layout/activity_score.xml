<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/background">

    <!-- Titre -->
    <TextView
        android:id="@+id/tvScoreTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Résultat du Quiz"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="24dp"
        android:gravity="center"/>

    <!-- Score -->
    <TextView
        android:id="@+id/tvScoreValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 35 / 50"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="8dp"/>

    <!-- Pourcentage -->
    <TextView
        android:id="@+id/tvPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="70%"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="24dp"/>

    <!-- Niveau -->
    <TextView
        android:id="@+id/tvLevelPlayed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Niveau : Débutant"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textColor="@color/on_surface_variant"
        android:layout_marginBottom="40dp"/>

    <!-- Bouton Recommencer -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Recommencer ce niveau"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- Bouton Retour -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Retour aux niveaux"
        app:cornerRadius="12dp"/>

</LinearLayout>
